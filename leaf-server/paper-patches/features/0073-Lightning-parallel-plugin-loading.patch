+package io.papermc.paper.plugin;
+
+import io.papermc.paper.plugin.provider.PluginProvider;
+import io.papermc.paper.plugin.provider.type.PluginFileType;
+import io.papermc.paper.plugin.provider.type.spigot.SpigotPluginProvider;
+
+/**
+ * Leaf Lightning plugins run concurrent workload phases where dependency order still permits it.
+ */
+public final class LeafLightningPlugins {
+
+    private LeafLightningPlugins() {
+    }
+
+    public static boolean isLightningProvider(PluginProvider<?> provider) {
+        return provider instanceof SpigotPluginProvider spigot
+            && spigot.file().getJarEntry(PluginFileType.LIGHTNING_PLUGIN_YML) != null;
+    }
+
+    /**
+     * Global parallelism for Lightning-only batches ({@code createInstance}+registration and {@code onLoad} segments).
+     * Prefer {@code -Dleaf.lightningPluginParallelism=N}; legacy {@code -Dleaf.lightningPluginLoadParallelism=N} is honored when unset.
+     */
+    public static int parallelism() {
+        Integer configured = Integer.getInteger("leaf.lightningPluginParallelism");
+        if (configured == null) {
+            configured = Integer.getInteger("leaf.lightningPluginLoadParallelism");
+        }
+        if (configured != null) {
+            return Math.min(256, Math.max(1, configured));
+        }
+        int cpus = Runtime.getRuntime().availableProcessors();
+        return Math.min(256, Math.max(2, cpus));
+    }
+}
