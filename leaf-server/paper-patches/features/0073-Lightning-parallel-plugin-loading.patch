+                activeLayer.sort(Comparator.comparingInt(topoIndex::get));
+
+                List<String> sequentialIds = new ArrayList<>();
+                List<String> lightningIds = new ArrayList<>();
+                for (String id : activeLayer) {
+                    PluginProviderEntry<T> entry = providerMap.get(id);
+                    if (entry == null || entry.provided) {
+                        continue;
+                    }
+                    if (LeafLightningPlugins.isLightningProvider(entry.provider)) {
+                        lightningIds.add(id);
+                    } else {
+                        sequentialIds.add(id);
+                    }
+                }
+
+                for (String id : sequentialIds) {
+                    this.loadProvider(providerMap, dependencyTree, id, loadedPlugins);
+                }
+
+                if (lightningIds.isEmpty()) {
+                    continue;
+                }
+                if (lightningExecutors == null || lightningIds.size() == 1) {
+                    for (String id : lightningIds) {
+                        this.loadProvider(providerMap, dependencyTree, id, loadedPlugins);
+                    }
+                } else {
+                    List<Future<?>> futures = new ArrayList<>(lightningIds.size());
+                    for (String id : lightningIds) {
+                        futures.add(lightningExecutors.submit(() -> this.loadProvider(providerMap, dependencyTree, id, loadedPlugins)));
+                    }
+                    for (Future<?> future : futures) {
+                        try {
+                            future.get();
+                        } catch (InterruptedException ex) {
+                            Thread.currentThread().interrupt();
+                            LOGGER.error("Interrupted while loading Lightning plugins", ex);
+                            break;
+                        } catch (ExecutionException ex) {
+                            LOGGER.error("Parallel Lightning plugin load failed", ex.getCause());
+                        }
+                    }
+                }
+            }
+        } finally {
+            if (lightningExecutors != null) {
+                lightningExecutors.shutdown();
+            }
+        }
+
+        loadedPlugins.sort(Comparator.comparingInt(pair -> topoIndex.getOrDefault(pair.provider().getMeta().getName(), Integer.MAX_VALUE)));
