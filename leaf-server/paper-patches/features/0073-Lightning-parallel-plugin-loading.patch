+        int parallelism = LeafLightningPlugins.parallelism();
+        ExecutorService lightningExecutors = parallelism > 1 ? Executors.newWorkStealingPool(parallelism) : null;
+        try {
+            for (List<String> layer : layers) {
+                List<String> activeLayer = new ArrayList<>(layer.size());
+                for (String id : layer) {
+                    PluginProviderEntry<T> entry = providerMap.get(id);
+                    if (entry != null && !entry.provided) {
+                        activeLayer.add(id);
