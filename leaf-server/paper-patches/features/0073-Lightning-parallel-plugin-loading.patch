+    List<List<String>> loadLayers() {
+        MutableGraph<String> work = GraphBuilder.from(this.graph).build();
+        for (String node : this.graph.nodes()) {
+            work.addNode(node);
+        }
+        for (EndpointPair<String> pair : this.graph.edges()) {
+            work.putEdge(pair.nodeU(), pair.nodeV());
+        }
+        List<List<String>> layers = new ArrayList<>();
+        while (!work.nodes().isEmpty()) {
+            List<String> roots = work.nodes().stream()
+                .filter(n -> work.inDegree(n) == 0)
+                .sorted()
+                .toList();
+            if (roots.isEmpty()) {
+                throw new IllegalStateException("Plugin load layer peeling failed — internal graph cycle.");
+            }
+            layers.add(new ArrayList<>(roots));
+            for (String node : roots) {
+                work.removeNode(node);
+            }
+        }
+        return layers;
+    }
+
