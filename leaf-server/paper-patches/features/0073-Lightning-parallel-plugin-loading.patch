+    @Override
+    protected void afterProvidersLoaded(List<ProviderLoadingStrategy.ProviderPair<JavaPlugin>> pairs) {
+        int parallelism = LeafLightningPlugins.parallelism();
+        ExecutorService pool = parallelism > 1 ? Executors.newWorkStealingPool(parallelism) : null;
+        try {
+            int i = 0;
+            while (i < pairs.size()) {
+                ProviderLoadingStrategy.ProviderPair<JavaPlugin> pair = pairs.get(i);
+                if (!LeafLightningPlugins.isLightningProvider(pair.provider())) {
+                    processProvided(pair.provider(), pair.provided());
+                    i++;
+                    continue;
+                }
+                int j = i;
+                while (j < pairs.size() && LeafLightningPlugins.isLightningProvider(pairs.get(j).provider())) {
+                    j++;
+                }
+                if (pool == null || j - i <= 1) {
+                    for (int k = i; k < j; k++) {
+                        ProviderLoadingStrategy.ProviderPair<JavaPlugin> p = pairs.get(k);
+                        processProvided(p.provider(), p.provided());
+                    }
+                } else {
+                    List<Future<?>> futures = new ArrayList<>(j - i);
+                    for (int k = i; k < j; k++) {
+                        final ProviderLoadingStrategy.ProviderPair<JavaPlugin> p = pairs.get(k);
+                        futures.add(pool.submit(() -> {
+                            processProvided(p.provider(), p.provided());
+                            return null;
+                        }));
+                    }
+                    for (Future<?> future : futures) {
+                        try {
+                            future.get();
+                        } catch (InterruptedException ex) {
+                            Thread.currentThread().interrupt();
+                            LOGGER.error("Interrupted during parallel Lightning plugin onLoad", ex);
+                            break;
+                        } catch (ExecutionException ex) {
+                            LOGGER.error("Parallel Lightning plugin onLoad failed", ex.getCause());
+                        }
+                    }
+                }
+                i = j;
+            }
+        } finally {
+            if (pool != null) {
+                pool.shutdown();
+            }
+        }
+    }
